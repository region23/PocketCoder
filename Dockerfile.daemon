FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH="/root/.local/bin:/root/.opencode/bin:${PATH}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        curl \
        nodejs \
        npm \
    && printf '%s\n' 'export PATH="/root/.local/bin:/root/.opencode/bin:$PATH"' > /etc/profile.d/pocketcoder-path.sh \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY pyproject.toml README.md /app/
COPY pocketcoder_daemon /app/pocketcoder_daemon
COPY pocketcoder_bot /app/pocketcoder_bot

RUN python -m pip install --no-cache-dir .

EXPOSE 8080

CMD ["pocketcoder-daemon"]
